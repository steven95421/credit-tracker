# Legacy Express/Plaid-only backend (`npm run dev:legacy`).
# The provider-aware Cloudflare Worker reads local secrets from worker/.dev.vars instead.
# Get Plaid keys at https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production  (start on sandbox; switch to production once Plaid Full Production access is granted)
PLAID_ENV=sandbox
# Comma-separated country codes for Plaid (Credit Tracker is US cards)
PLAID_COUNTRY_CODES=US
# Plaid products to request at Link time
PLAID_PRODUCTS=transactions

# Server
PORT=8080
# Where the SQLite file lives (relative to repo root or absolute)
DB_PATH=server/data/credit-tracker.db
