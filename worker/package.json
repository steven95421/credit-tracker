{
  "name": "credit-tracker-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --var DEV_MODE:1",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create credit-tracker",
    "db:init:fresh": "node scripts/init-fresh-db.mjs --remote",
    "db:init:fresh:local": "node scripts/init-fresh-db.mjs --local",
    "db:migrate": "wrangler d1 migrations apply credit-tracker --remote",
    "db:migrate:local": "wrangler d1 migrations apply credit-tracker --local",
    "db:seed": "wrangler d1 execute credit-tracker --remote --file=seed.sql",
    "db:seed:local": "wrangler d1 execute credit-tracker --local --file=seed.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "wrangler": "4.127.1"
  }
}
